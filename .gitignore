# --- Виртуальные окружения ---
# Каждый подпроект живёт в своём venv, в git он не нужен.
venv/
.venv/
env/

# --- Кэш Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Артефакты Chainlit ---
# .files/ — загруженные пользователями файлы, translations/ — встроенные переводы.
# **/ нужен, т.к. паттерны с внутренним слэшем git иначе привязывает к корню репо.
**/.files/
**/.chainlit/translations/

# --- Логи и локальные настройки ---
*.log
.env
.envrc

# --- Данные индекса и кэш эмбеддингов ---
# Каталог data/ появится при переходе к реальному пайплайну.
data/index/
data/cache/
*.bin

# --- Артефакты сборки/упаковки ---
build/
dist/
*.egg-info/

# --- Среда и ОС ---
.vscode/
.idea/
.DS_Store
Thumbs.db
